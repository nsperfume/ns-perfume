# Copy to .env.local for development. In production set these in the hosting
# dashboard (e.g. Vercel > Project > Settings > Environment Variables).

# ---- Site ---------------------------------------------------------------
# Public origin used in emails, sitemap, invoices and canonical URLs.
NEXT_PUBLIC_SITE_URL=https://nsperfume.pk
# Customer care address shown on the site and used as Reply-To.
NEXT_PUBLIC_CONTACT_EMAIL=care@nsperfume.pk

# ---- Database (MongoDB Atlas) -------------------------------------------
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?appName=ns-perfume
MONGODB_DB=ns-perfume

# ---- Admin ----------------------------------------------------------------
# Super admin created/synced on login. Use a long, unique password.
ADMIN_EMAIL=owner@nsperfume.pk
ADMIN_PASSWORD=
# 32+ random characters. Generate: openssl rand -base64 48
ADMIN_JWT_SECRET=
# Optional separate key for customer sessions (derived from ADMIN_JWT_SECRET if empty).
CUSTOMER_JWT_SECRET=

# ---- Email (Gmail / Google Workspace app password, or any SMTP) ----------
# The address the app password belongs to.
SMTP_USER=
# 16 character app password (APP_PASSWORD is also accepted).
SMTP_PASS=
# Defaults: smtp.gmail.com, port 465 (TLS).
SMTP_HOST=
SMTP_PORT=
MAIL_FROM_NAME=NS Perfume
# Defaults to SMTP_USER. Gmail only allows addresses verified on the account.
MAIL_FROM_ADDRESS=
# Where customer replies go (defaults to NEXT_PUBLIC_CONTACT_EMAIL).
MAIL_REPLY_TO=
# Comma-separated inboxes for new order / contact alerts (defaults to SMTP_USER).
MAIL_ADMIN_TO=

# ---- Image uploads (Cloudinary) -----------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=ns-perfume

# ---- Google sign-in (optional) ------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Defaults to <site>/api/auth/google/callback
GOOGLE_REDIRECT_URI=

# ---- Maintenance (optional) ---------------------------------------------
# Header secret for POST /api/admin/seed. Leave empty in production.
SEED_SECRET=
# Allow ?force=1 catalog replacement in production. Keep unset.
ALLOW_DESTRUCTIVE_SEED=
